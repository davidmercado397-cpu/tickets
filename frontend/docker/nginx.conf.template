# Plantilla nginx. El entrypoint sustituye ${API_BACKEND} (envsubst) y escribe
# /etc/nginx/conf.d/default.conf. Las variables de nginx ($host, $uri…) NO son
# variables de entorno, así que envsubst las deja intactas.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location /api/ {
        # Resolución DNS en tiempo de REQUEST (no al arrancar): usar una variable en
        # proxy_pass evita el crash "host not found in upstream". 127.0.0.11 = DNS
        # embebido de Docker (resuelve nombres de servicio y también nombres públicos,
        # que reenvía al DNS del host).
        resolver 127.0.0.11 ipv6=off valid=10s;
        set $api_backend "${API_BACKEND}";

        # Extrae el host (sin esquema ni puerto) para el header Host y el SNI: al proxyar
        # a una URL PÚBLICA (Cloudflare/Traefik del backend) el Host debe ser el del
        # backend, no el del front, o la ruta no enruta (502). Para un backend HTTP
        # interno esto es inofensivo (FastAPI ignora el Host).
        if ($api_backend ~* "^https?://([^:/]+)") {
            set $api_host $1;
        }

        proxy_pass $api_backend$request_uri;
        proxy_http_version 1.1;

        # HTTPS al upstream: envía SNI correcto (ignorado si el backend es HTTP).
        proxy_ssl_server_name on;
        proxy_ssl_name $api_host;

        proxy_set_header Host $api_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSE (p.ej. /api/notifications/stream): sin buffering y timeout largo.
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    # Assets con hash: cache agresiva.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA fallback: cualquier ruta desconocida sirve index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
