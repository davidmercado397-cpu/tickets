# Configuración por entorno del servicio Ticketing. Copiar a .env en desarrollo.
# Los secretos llegan SIEMPRE por entorno (Coolify), nunca viven en el repo.

# --- Obligatorias (fail-fast en arranque) ---
# Base de datos. Ej: postgresql+asyncpg://user:pass@host:5432/db
DATABASE_URL=postgresql+asyncpg://tickets:tickets@postgres:5432/tickets
# Token de servicio (Bearer) que el Gateway usa para llamar a esta API. Genera uno largo y aleatorio:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TICKETING_SERVICE_TOKEN=

# --- Radicado ---
# Prefijo del número de radicado: {PREFIX}-{YYYY}-{NNNNNN} (p.ej. SRV-2026-000123).
RADICADO_PREFIX=SRV
# Prefijo base de la API (el contrato del bot cuelga de aquí).
API_PREFIX=/api
# CORS: orígenes del front (coma-separados). El bot/Gateway NO lo necesita. Vacío = sin CORS.
# Ej: https://tickets.nextbyte.com,http://localhost:5173
CORS_ORIGINS=
# Prioridad por defecto (clasificación + SLA) cuando el bot no la manda.
DEFAULT_PRIORITY=medium

# --- Auth de usuarios humanos (RBAC del front) ---
# Clave de firma de los JWT de sesión (HS256, >=32 bytes, OBLIGATORIA). Genera:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SIGNING_KEY=
AUTH_ACCESS_TOKEN_TTL_SECONDS=28800
# Semilla del primer admin (se crea en el arranque si no existe). Bootstrap sin endpoint operador.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Gateway (WhatsApp saliente): notificaciones staff + evento de vuelta ---
GATEWAY_BASE_URL=
# Clave INTERNA del Gateway (su INTERNAL_API_KEY): la enviamos como X-Internal-Key a su POST /send.
GATEWAY_INTERNAL_KEY=

# --- Notificaciones (inc 3) ---
# Redis: bus del stream SSE de notificaciones (in-app siempre activo).
REDIS_URL=redis://redis:6379/0
SSE_HEARTBEAT_SECONDS=15
# WhatsApp a empleados vía el POST /send del Gateway (plantilla aprobada). Requiere GATEWAY_BASE_URL +
# GATEWAY_INTERNAL_KEY + WHATSAPP_TEMPLATE_NAME para activarse.
NOTIFY_WHATSAPP_ENABLED=false
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=es
WHATSAPP_PHONE_NUMBER_ID=
# Evento de vuelta al usuario final (B3): avisar al solicitante por WhatsApp al cambiar el caso.
# Requiere GATEWAY_BASE_URL + GATEWAY_INTERNAL_KEY + USER_EVENT_TEMPLATE_NAME.
NOTIFY_USER_ENABLED=false
USER_EVENT_TEMPLATE_NAME=
USER_EVENT_TEMPLATE_LANG=es
NOTIFY_USER_STATUSES=closed
# Email (SMTP genérico). Requiere SMTP_HOST + SMTP_FROM para activarse.
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- Almacenamiento propio en R2 (S3-compatible) — PDFs de certificados ---
# Si no se configura, el endpoint de certificado responde 503 (el resto de la app funciona igual).
R2_ENDPOINT_URL=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_SIGNED_URL_TTL_SECONDS=3600

# --- Certificado laboral (textos fijos; defaults del ejemplo de Servigpoder) ---
CERTIFICATE_CATEGORY_CODE=certificado_laboral
CERT_SIGNATORY_NAME=ANGELICA PATRICIA GOMEZ ALZATE
CERT_SIGNATORY_TITLE=Auxiliar de servicio de cliente interno
CERT_FOOTER_WHATSAPP=3135877576
CERT_CITY=Santiago de Cali
# Ruta a un PNG de logo/membrete (opcional; sin él sale el membrete de texto).
CERT_LOGO_PATH=

# --- Reservadas (groundwork) ---
# Cifrado en reposo (Fernet) para secretos que deban descifrarse.
SECRETS_ENCRYPTION_KEY=

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_TZ_OFFSET_HOURS=-5
