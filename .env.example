# Copia este archivo a .env y reemplaza los valores marcados con CAMBIAR.
# Genera secretos con:  docker run --rm python:3.13-slim python -c "import secrets; print(secrets.token_urlsafe(48))"

# Perfil "local" levanta Mailpit (correo de prueba). En la nube déjalo vacío.
COMPOSE_PROFILES=local

# Puertos publicados en el equipo
WEB_PORT=8080
API_PORT=8000
MAILPIT_PORT=8025

# --- Base de datos ---
POSTGRES_USER=pqrs
POSTGRES_PASSWORD=CAMBIAR
POSTGRES_DB=pqrs

# --- Seguridad ---
AUTH_JWT_SIGNING_KEY=CAMBIAR_minimo_32_caracteres
# Fernet (cifra la clave del buzón IMAP). Genera: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=CAMBIAR

# URL pública del frontend (enlaces en los correos)
PUBLIC_BASE_URL=http://localhost:8080
APP_NAME="PQRS Seguridad"

# --- Siembra inicial ---
SEED_SUPERADMIN_EMAIL=superadmin@plataforma.local
SEED_SUPERADMIN_PASSWORD=CAMBIAR
# Empresa de demostración "servigpoder" con su administrador
SEED_DEMO_TENANT=true
SEED_DEMO_ADMIN_EMAIL=admin@servigpoder.co
SEED_DEMO_ADMIN_PASSWORD=CAMBIAR

# --- Almacenamiento S3 (SeaweedFS local; en la nube puede ser R2/S3) ---
S3_ENDPOINT_URL=http://storage:8333
S3_BUCKET=pqrs
S3_ACCESS_KEY_ID=CAMBIAR
S3_SECRET_ACCESS_KEY=CAMBIAR
S3_REGION=us-east-1
MAX_UPLOAD_MB=15

# --- Correo saliente (local: Mailpit) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=pqrs@servigpoder.local
SMTP_USE_TLS=false
SMTP_START_TLS=false

# --- Worker ---
WORKER_IMAP_POLL_SECONDS=120
WORKER_SLA_SCAN_SECONDS=900

LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_TZ_OFFSET_HOURS=-5
